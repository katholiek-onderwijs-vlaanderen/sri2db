{
  "root": true,
  "env": {
    "node": true,
    "commonjs": true,
    "es2022": true
  },
  "extends": ["eslint:recommended", "prettier"],
  "parserOptions": {
    "ecmaVersion": 2022
  },
  "rules": {
    "no-unused-vars": ["warn", { "args": "after-used" }]
  },
  "overrides": [
    {
      "files": ["test/**/*.mjs"],
      "parserOptions": { "sourceType": "module" },
      "env": { "mocha": true }
    }
  ]
}